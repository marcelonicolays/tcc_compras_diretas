    {
      "cell_type": "code",
      "source": [
        "# 1. Preparar a matriz utilizada pelo K-Means\n",
        "X_denso = X.toarray() if hasattr(X, 'toarray') else np.asarray(X)\n",
        "\n",
        "if X_denso.shape[0] != len(df_ml):\n",
        "    raise ValueError(\"X e df_ml possuem quantidades diferentes de registros.\")\n",
        "\n",
        "# 2. Projetar os registros em duas dimensões\n",
        "pca = PCA(\n",
        "    n_components=2,\n",
        "    svd_solver='randomized',\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "coordenadas = pca.fit_transform(X_denso)\n",
        "\n",
        "df_ml['pca_x'] = coordenadas[:, 0]\n",
        "df_ml['pca_y'] = coordenadas[:, 1]\n",
        "\n",
        "# 3. Calcular as coordenadas dos centroides na mesma projeção\n",
        "centros = modelo_kmeans.cluster_centers_\n",
        "centros_2d = pca.transform(centros)\n",
        "\n",
        "# Centro global: média de todas as observações no espaço do modelo\n",
        "centro_global = X_denso.mean(axis=0)\n",
        "centro_global_2d = pca.transform(\n",
        "    centro_global.reshape(1, -1)\n",
        ")[0]\n",
        "\n",
        "# Distância de cada centroide ao centro global, no espaço original\n",
        "distancias_globais = np.linalg.norm(\n",
        "    centros - centro_global,\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "# Quantidade de registros por cluster\n",
        "n_clusters = modelo_kmeans.n_clusters\n",
        "\n",
        "tamanhos = (\n",
        "    df_ml['cluster_kmeans']\n",
        "    .value_counts()\n",
        "    .reindex(range(n_clusters), fill_value=0)\n",
        "    .to_numpy()\n",
        ")\n",
        "\n",
        "# 4. Distância de cada registro ao próprio centroide\n",
        "distancias = modelo_kmeans.transform(X_denso)\n",
        "rotulos = df_ml['cluster_kmeans'].to_numpy()\n",
        "\n",
        "distancias_proprias = distancias[\n",
        "    np.arange(len(df_ml)), rotulos\n",
        "]\n",
        "\n",
        "df_ml['distancia_centroide_kmeans'] = distancias_proprias\n",
        "\n",
        "# Marcar os 1% de registros mais distantes dos próprios centroides\n",
        "limite = np.quantile(distancias_proprias, 0.99)\n",
        "mask_distantes = distancias_proprias >= limite\n",
        "\n",
        "# 5. Informações exibidas ao passar o mouse sobre os registros\n",
        "colunas_hover = [\n",
        "    c for c in [\n",
        "        'idprocesso',\n",
        "        'numero_processo',\n",
        "        'fornecedor',\n",
        "        'unidade',\n",
        "        'item',\n",
        "        'valor_processo',\n",
        "        'valor_unitario',\n",
        "        'cluster_kmeans',\n",
        "        'distancia_centroide_kmeans'\n",
        "    ]\n",
        "    if c in df_ml.columns\n",
        "]\n",
        "\n",
        "nomes_legiveis = {\n",
        "    'idprocesso': 'ID do processo',\n",
        "    'numero_processo': 'Número do processo',\n",
        "    'fornecedor': 'Fornecedor',\n",
        "    'unidade': 'Unidade contratante',\n",
        "    'item': 'Item',\n",
        "    'valor_processo': 'Valor do processo',\n",
        "    'valor_unitario': 'Valor unitário',\n",
        "    'cluster_kmeans': 'Cluster',\n",
        "    'distancia_centroide_kmeans': 'Distância ao próprio centroide'\n",
        "}\n",
        "\n",
        "dados_hover = df_ml[colunas_hover].astype(str).to_numpy()\n",
        "\n",
        "linhas_hover = ''.join(\n",
        "    f'{nomes_legiveis.get(c, c)}: %{{customdata[{i}]}}<br>'\n",
        "    for i, c in enumerate(colunas_hover)\n",
        ")\n",
        "\n",
        "# 6. Construir o mapa interativo\n",
        "fig = go.Figure()\n",
        "\n",
        "# Todos os registros: pequenos e transparentes para reduzir sobreposição\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=df_ml['pca_x'],\n",
        "    y=df_ml['pca_y'],\n",
        "    mode='markers',\n",
        "    name='Registros',\n",
        "    customdata=dados_hover,\n",
        "    hovertemplate=linhas_hover + '<extra></extra>',\n",
        "    marker=dict(\n",
        "        size=4,\n",
        "        opacity=0.28,\n",
        "        color=df_ml['cluster_kmeans'],\n",
        "        colorscale='Turbo',\n",
        "        showscale=True,\n",
        "        colorbar=dict(title='Cluster')\n",
        "    )\n",
        "))\n",
        "\n",
        "# Registros mais distantes dos próprios centroides\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=df_ml.loc[mask_distantes, 'pca_x'],\n",
        "    y=df_ml.loc[mask_distantes, 'pca_y'],\n",
        "    mode='markers',\n",
        "    name='1% mais distantes',\n",
        "    customdata=dados_hover[mask_distantes],\n",
        "    hovertemplate=linhas_hover + '<extra></extra>',\n",
        "    marker=dict(\n",
        "        symbol='x',\n",
        "        size=9,\n",
        "        color='red',\n",
        "        opacity=0.9\n",
        "    )\n",
        "))\n",
        "\n",
        "# Centroides dos 22 clusters\n",
        "dados_centros = np.column_stack([\n",
        "    np.arange(n_clusters),\n",
        "    tamanhos,\n",
        "    distancias_globais\n",
        "])\n",
        "\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=centros_2d[:, 0],\n",
        "    y=centros_2d[:, 1],\n",
        "    mode='markers+text',\n",
        "    name='Centroides dos clusters',\n",
        "    text=[f'C{i}' for i in range(n_clusters)],\n",
        "    textposition='top center',\n",
        "    customdata=dados_centros,\n",
        "    hovertemplate=(\n",
        "        '<b>Centroide C%{customdata[0]:.0f}</b><br>'\n",
        "        'Registros: %{customdata[1]:.0f}<br>'\n",
        "        'Distância ao centro global: %{customdata[2]:.3f}'\n",
        "        '<extra></extra>'\n",
        "    ),\n",
        "    marker=dict(\n",
        "        symbol='diamond',\n",
        "        size=13,\n",
        "        color='black',\n",
        "        line=dict(color='white', width=1)\n",
        "    )\n",
        "))\n",
        "\n",
        "# Centro global\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=[centro_global_2d[0]],\n",
        "    y=[centro_global_2d[1]],\n",
        "    mode='markers+text',\n",
        "    name='Centro global',\n",
        "    text=['CENTRO GLOBAL'],\n",
        "    textposition='bottom right',\n",
        "    hovertemplate=(\n",
        "        '<b>Centro global</b><br>'\n",
        "        'Centro médio de todas as observações'\n",
        "        '<extra></extra>'\n",
        "    ),\n",
        "    marker=dict(\n",
        "        symbol='star',\n",
        "        size=22,\n",
        "        color='orange',\n",
        "        line=dict(color='black', width=1.5)\n",
        "    )\n",
        "))\n",
        "\n",
        "variancia = pca.explained_variance_ratio_.sum() * 100\n",
        "\n",
        "fig.update_layout(\n",
        "    title=(\n",
        "        'Mapa 2D dos registros, centroides e centro global'\n",
        "        f'<br><sup>PCA: {variancia:.2f}% da variância explicada '\n",
        "        'pelos dois eixos</sup>'\n",
        "    ),\n",
        "    xaxis_title='Componente principal 1 (PCA)',\n",
        "    yaxis_title='Componente principal 2 (PCA)',\n",
        "    template='plotly_white',\n",
        "    height=800,\n",
        "    hovermode='closest',\n",
        "    legend=dict(\n",
        "        orientation='h',\n",
        "        yanchor='bottom',\n",
        "        y=1.02,\n",
        "        xanchor='left',\n",
        "        x=0\n",
        "    )\n",
        ")\n",
        "\n",
        "fig.show()\n",
        "\n",
        "print(f\"Registros: {len(df_ml):,}\")\n",
        "print(f\"Clusters: {n_clusters}\")\n",
        "print(f\"Variância explicada pelo PCA: {variancia:.2f}%\")\n",
        "print(f\"Registros entre os 1% mais distantes: {mask_distantes.sum():,}\")\n",
        "print(f\"Limite de distância para esse grupo: {limite:.4f}\")\n"
      ],
      "metadata": {
