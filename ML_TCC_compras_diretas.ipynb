      "cell_type": "markdown",
      "source": [
        "## K-Means"
      ],
      "metadata": {
        "id": "TeCM7MYKrNBL"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "* Análise de k"
      ],
      "metadata": {
        "id": "cdDLJBZDJJ_1"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Confirmar a matriz de entrada\n",
        "print(f\"Formato da matriz X: {X.shape}\")\n",
        "print(f\"Matriz esparsa: {sparse.issparse(X)}\")\n",
        "\n",
        "# Faixa inicial de K: 10 a 50, de 1 em 1\n",
        "valores_k = list(range(10, 51, 1))\n",
        "\n",
        "# Selecionar uma amostra fixa para comparar os Silhouette Scores\n",
        "rng = np.random.default_rng(42)\n",
        "tamanho_amostra = min(2500, X.shape[0])\n",
        "indices_amostra = np.sort(\n",
        "    rng.choice(X.shape[0], size=tamanho_amostra, replace=False)\n",
        ")\n",
        "\n",
        "X_amostra = X[indices_amostra]\n",
        "\n",
        "resultados_kmeans = []\n",
        "\n",
        "for k in valores_k:\n",
        "    print(f\"Testando K = {k}...\")\n",
        "\n",
        "    modelo = KMeans(\n",
        "        n_clusters=k,\n",
        "        random_state=42,\n",
        "        n_init=5,\n",
        "        max_iter=300,\n",
        "        algorithm='lloyd'\n",
        "    )\n",
        "\n",
        "    # Ajustar o modelo em todos os registros\n",
        "    modelo.fit(X)\n",
        "\n",
        "    # Silhouette calculado na mesma amostra em todos os testes\n",
        "    silhouette = silhouette_score(\n",
        "        X_amostra,\n",
        "        modelo.labels_[indices_amostra],\n",
        "        metric='euclidean'\n",
        "    )\n",
        "\n",
        "    resultados_kmeans.append({\n",
        "        'K': k,\n",
        "        'Inercia': modelo.inertia_,\n",
        "        'Silhouette': silhouette\n",
        "    })\n",
        "\n",
        "# Organizar os resultados\n",
        "df_resultados_kmeans = pd.DataFrame(resultados_kmeans)\n",
        "\n",
        "print(\"\\nResultados dos testes:\")\n",
        "display(\n",
        "    df_resultados_kmeans.round({\n",
        "        'Inercia': 2,\n",
        "        'Silhouette': 4\n",
        "    })\n",
        ")\n",
        "\n",
        "print(\"\\nCinco melhores valores de K pelo Silhouette:\")\n",
        "display(\n",
        "    df_resultados_kmeans\n",
        "    .sort_values('Silhouette', ascending=False)\n",
        "    .head(5)\n",
        "    .round({'Inercia': 2, 'Silhouette': 4})\n",
        ")\n",
        "\n",
        "# Gráfico 1: método do cotovelo\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(\n",
        "    df_resultados_kmeans['K'],\n",
        "    df_resultados_kmeans['Inercia'],\n",
        "    marker='o'\n",
        ")\n",
        "plt.xlabel('Número de clusters (K)')\n",
        "plt.ylabel('Inércia')\n",
        "plt.title('K-Means — método do cotovelo')\n",
        "plt.xticks(valores_k)\n",
        "plt.grid(alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "# Gráfico 2: Silhouette Score\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(\n",
        "    df_resultados_kmeans['K'],\n",
        "    df_resultados_kmeans['Silhouette'],\n",
        "    marker='o'\n",
        ")\n",
        "plt.xlabel('Número de clusters (K)')\n",
        "plt.ylabel('Silhouette Score')\n",
        "plt.title('K-Means — comparação do Silhouette Score')\n",
        "plt.xticks(valores_k)\n",
        "plt.grid(alpha=0.3)\n",
        "plt.show()\n"
      ],
