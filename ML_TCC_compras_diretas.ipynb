        "    connect_args={\n",
        "        'sslmode': 'require',\n",
        "        'connect_timeout': 15\n",
        "    },\n",
        "    pool_pre_ping=True,\n",
        "    pool_size=1,\n",
        "    max_overflow=0\n",
        ")\n",
        "\n",
        "# Testa a conexão\n",
        "try:\n",
        "    with engine.connect() as conn:\n",
        "        resultado = conn.execute(\n",
        "            text('SELECT current_database(), current_schema()')\n",
