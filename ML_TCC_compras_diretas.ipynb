      "cell_type": "markdown",
      "source": [
        "Refinar consulta entre k 18 e 50"
      ],
      "metadata": {
        "id": "FNbYjS_Tj0jA"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Testar todos os valores inteiros entre 36 e 60\n",
        "valores_k_refinados = range(18, 50)\n",
        "\n",
        "# Reutilizar a amostra fixa da etapa anterior\n",
        "# Se ela não existir, criar uma amostra reproduzível\n",
        "if 'indices_amostra' not in globals():\n",
        "    rng = np.random.default_rng(42)\n",
        "    indices_amostra = np.sort(\n",
        "        rng.choice(X.shape[0], size=min(2500, X.shape[0]),\n",
        "                   replace=False)\n",
        "    )\n",
        "\n",
        "X_amostra = X[indices_amostra]\n",
        "\n",
        "resultados_refinados = []\n",
        "\n",
        "for k in valores_k_refinados:\n",
        "    print(f\"Testando K = {k}...\")\n",
        "\n",
        "    modelo = KMeans(\n",
        "        n_clusters=k,\n",
        "        random_state=42,\n",
        "        n_init=10,\n",
        "        max_iter=300,\n",
        "        algorithm='lloyd'\n",
        "    )\n",
        "\n",
        "    modelo.fit(X)\n",
        "\n",
        "    silhouette = silhouette_score(\n",
        "        X_amostra,\n",
        "        modelo.labels_[indices_amostra],\n",
        "        metric='euclidean'\n",
        "    )\n",
        "\n",
        "    resultados_refinados.append({\n",
        "        'K': k,\n",
        "        'Inercia': modelo.inertia_,\n",
        "        'Silhouette': silhouette\n",
        "    })\n",
        "\n",
        "df_refinamento_k = pd.DataFrame(resultados_refinados)\n",
        "\n",
        "# Exibir os melhores candidatos\n",
        "print(\"\\nDez melhores resultados pelo Silhouette:\")\n",
        "display(\n",
        "    df_refinamento_k\n",
        "    .sort_values('Silhouette', ascending=False)\n",
        "    .head(10)\n",
        "    .round({'Inercia': 2, 'Silhouette': 4})\n",
        ")\n",
        "\n",
        "# Detectar possível cotovelo na curva de inércia\n",
        "detector = KneeLocator(\n",
        "    df_refinamento_k['K'].to_numpy(),\n",
        "    df_refinamento_k['Inercia'].to_numpy(),\n",
        "    curve='convex',\n",
        "    direction='decreasing'\n",
        ")\n",
        "\n",
        "if detector.knee is not None:\n",
        "    print(f\"\\nPossível cotovelo da inércia: K = {detector.knee}\")\n",
        "else:\n",
        "    print(\"\\nNenhum cotovelo claro foi identificado nessa faixa.\")\n",
        "\n",
        "# Gráfico da inércia\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(\n",
        "    df_refinamento_k['K'],\n",
        "    df_refinamento_k['Inercia'],\n",
        "    marker='o'\n",
        ")\n",
        "if detector.knee is not None:\n",
        "    plt.axvline(\n",
        "        detector.knee,\n",
        "        linestyle='--',\n",
        "        label=f'Cotovelo estimado: K={detector.knee}'\n",
        "    )\n",
        "plt.xlabel('Número de clusters (K)')\n",
        "plt.ylabel('Inércia')\n",
        "plt.title('Refinamento do método do cotovelo')\n",
        "plt.xticks(list(valores_k_refinados))\n",
        "plt.grid(alpha=0.3)\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# Gráfico do Silhouette\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(\n",
        "    df_refinamento_k['K'],\n",
        "    df_refinamento_k['Silhouette'],\n",
        "    marker='o'\n",
        ")\n",
        "plt.xlabel('Número de clusters (K)')\n",
        "plt.ylabel('Silhouette Score')\n",
        "plt.title('Refinamento do Silhouette Score')\n",
        "plt.xticks(list(valores_k_refinados))\n",
        "plt.grid(alpha=0.3)\n",
        "plt.show()\n"
      ],
