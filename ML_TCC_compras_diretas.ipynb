      "source": [
        "## Comparação dos Métodos"
      ],
      "metadata": {
        "id": "FTaReEkHnCr4"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Métodos utilizados na comparação\n",
        "metodos = ['KMeans', 'IsolationForest', 'DBSCAN', 'Z-score']\n",
        "\n",
        "# Sinalizações individuais\n",
        "sinais = pd.DataFrame({\n",
        "    'idprocesso': df_ml['idprocesso'].to_numpy(),\n",
        "\n",
        "    'KMeans': (\n",
        "        df_ml['cluster_kmeans']\n",
        "        .isin([1, 2, 7, 9, 19])\n",
        "        .to_numpy()\n",
        "    ),\n",
        "\n",
        "    'IsolationForest': (\n",
        "        df_ml['anomalia_iforest']\n",
        "        .fillna(False)\n",
        "        .astype(bool)\n",
        "        .to_numpy()\n",
        "    ),\n",
        "\n",
        "    'DBSCAN': (\n",
        "        np.asarray(resultados_min_samples[10]) == -1\n",
        "    ),\n",
        "\n",
        "    'Z-score': (\n",
        "        df_ml['anomalia_zscore']\n",
        "        .fillna(False)\n",
        "        .astype(bool)\n",
        "        .to_numpy()\n",
        "    )\n",
        "})\n",
        "\n",
        "# Quantidade de métodos que sinalizaram cada item\n",
        "sinais['qtd_metodos'] = sinais[metodos].sum(axis=1)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. Combinações específicas entre os métodos\n",
        "# --------------------------------------------------\n",
        "\n",
        "df_combinacoes = (\n",
        "    sinais[sinais['qtd_metodos'] > 0]\n",
        "    .groupby(metodos, as_index=False)\n",
        "    .agg(\n",
        "        itens=('idprocesso', 'size'),\n",
        "        processos=('idprocesso', 'nunique')\n",
        "    )\n",
        ")\n",
        "\n",
        "df_combinacoes['qtd_metodos'] = (\n",
        "    df_combinacoes[metodos].sum(axis=1)\n",
        ")\n",
        "\n",
        "df_combinacoes['metodos_sinalizadores'] = (\n",
        "    df_combinacoes.apply(\n",
        "        lambda linha: ' + '.join(\n",
        "            metodo for metodo in metodos\n",
        "            if linha[metodo]\n",
        "        ),\n",
        "        axis=1\n",
        "    )\n",
        ")\n",
        "\n",
        "df_combinacoes = (\n",
        "    df_combinacoes[\n",
        "        ['metodos_sinalizadores', 'qtd_metodos', 'itens', 'processos']\n",
        "    ]\n",
        "    .sort_values(\n",
        "        ['qtd_metodos', 'itens'],\n",
        "        ascending=[False, False]\n",
        "    )\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "print('COMBINAÇÕES ENTRE OS MÉTODOS')\n",
        "display(df_combinacoes)\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. Concordância entre os métodos\n",
        "# --------------------------------------------------\n",
        "\n",
        "total_processos = df_ml['idprocesso'].nunique()\n",
        "\n",
        "resultados_concordancia = []\n",
        "\n",
        "for minimo_metodos in range(1, 5):\n",
        "\n",
        "    selecionados = sinais[\n",
        "        sinais['qtd_metodos'] >= minimo_metodos\n",
        "    ]\n",
        "\n",
        "    processos = selecionados['idprocesso'].nunique()\n",
        "\n",
        "    resultados_concordancia.append({\n",
        "        'criterio': f'Pelo menos {minimo_metodos} método(s)',\n",
        "        'itens_sinalizados': len(selecionados),\n",
        "        'processos_sinalizados': processos,\n",
        "        'percentual_processos': (\n",
        "            processos / total_processos * 100\n",
        "        )\n",
        "    })\n",
        "\n",
        "df_concordancia = pd.DataFrame(resultados_concordancia)\n",
        "\n",
        "print('RESUMO DA CONCORDÂNCIA')\n",
        "display(df_concordancia)\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. Registros sem avaliação pelo Z-score\n",
        "# --------------------------------------------------\n",
        "\n",
        "total_na_zscore = df_ml['zscore_preco'].isna().sum()\n",
        "\n",
        "ruido_na_zscore = (\n",
        "    (sinais['DBSCAN'])\n",
        "    & (df_ml['zscore_preco'].isna().to_numpy())\n",
        ").sum()\n",
        "\n",
        "print(f'Registros sem Z-score calculável: {total_na_zscore:,}')\n",
        "print(f'Registros de ruído do DBSCAN sem Z-score calculável: {ruido_na_zscore:,}')"
      ],
