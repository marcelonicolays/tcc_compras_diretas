        "* anomalia_dbscan"
      ],
      "metadata": {
        "id": "WVwRNS0knqIc"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Configuração definitiva\n",
        "modelo_dbscan = DBSCAN(\n",
        "    eps=1.41,\n",
        "    min_samples=10,\n",
        "    metric='euclidean',\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "# Executar agrupamento\n",
        "df_ml['cluster_dbscan'] = modelo_dbscan.fit_predict(X)\n",
        "\n",
        "# Identificar registros classificados como ruído\n",
        "df_ml['anomalia_dbscan'] = (\n",
        "    df_ml['cluster_dbscan'] == -1\n",
        ")\n",
        "\n",
        "# Resumo geral\n",
        "total_registros = len(df_ml)\n",
        "total_ruido = df_ml['anomalia_dbscan'].sum()\n",
        "total_clusters = df_ml.loc[\n",
        "    df_ml['cluster_dbscan'] != -1,\n",
        "    'cluster_dbscan'\n",
        "].nunique()\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"DBSCAN EXECUTADO COM SUCESSO\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(f\"Total de registros: {total_registros:,}\")\n",
        "print(f\"EPS: {modelo_dbscan.eps}\")\n",
        "print(f\"Min_samples: {modelo_dbscan.min_samples}\")\n",
        "print(f\"Quantidade de clusters: {total_clusters}\")\n",
        "print(f\"Registros classificados como ruído: {total_ruido:,}\")\n",
        "print(f\"Percentual de ruído: {total_ruido / total_registros * 100:.2f}%\")\n",
        "\n",
        "# Distribuição dos clusters\n",
        "distribuicao = (\n",
        "    df_ml['cluster_dbscan']\n",
        "    .value_counts()\n",
        "    .sort_index()\n",
        "    .rename_axis('Cluster')\n",
        "    .reset_index(name='Quantidade')\n",
        ")\n",
        "\n",
        "distribuicao['Percentual'] = (\n",
        "    distribuicao['Quantidade'] / total_registros * 100\n",
        ")\n",
        "\n",
        "print(\"\\nDISTRIBUIÇÃO DOS CLUSTERS\")\n",
        "display(distribuicao.round(2))\n",
        "\n",
        "# Conferência dos registros classificados como ruído\n",
        "print(\"\\nREGISTROS CLASSIFICADOS COMO RUÍDO\")\n",
        "display(\n",
        "    df_ml[df_ml['anomalia_dbscan']]\n",
        "    .head(10)\n",
        ")\n"
      ],
