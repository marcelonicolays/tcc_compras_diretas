      "source": [
        "# Conferência da matriz de entrada\n",
        "if X.shape[0] != len(df_ml):\n",
        "    raise ValueError(\"X e df_ml possuem quantidades diferentes de registros.\")\n",
        "\n",
        "# Parâmetros para investigação\n",
        "valores_eps = [1.4, 1.5, 1.6]\n",
        "valores_min_samples = [10, 15, 20]\n",
        "\n",
        "resultados_dbscan = {}\n",
        "resumo_dbscan = []\n",
        "\n",
        "print(\"INICIANDO TESTES DO DBSCAN\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "for eps in valores_eps:\n",
        "\n",
        "    for min_samples in valores_min_samples:\n",
        "\n",
        "        print(f\"Executando eps={eps} | min_samples={min_samples}...\")\n",
        "\n",
        "        modelo = DBSCAN(\n",
        "            eps=eps,\n",
        "            min_samples=min_samples,\n",
        "            metric='euclidean',\n",
        "            n_jobs=-1\n",
        "        )\n",
        "\n",
        "        rotulos = modelo.fit_predict(X)\n",
        "\n",
        "        # Armazenar os resultados para comparação posterior\n",
        "        resultados_dbscan[(eps, min_samples)] = rotulos\n",
        "\n",
        "        # Identificar ruídos e clusters\n",
        "        quantidade_ruido = np.sum(rotulos == -1)\n",
        "        percentual_ruido = quantidade_ruido / len(rotulos) * 100\n",
        "\n",
        "        clusters_validos = rotulos[rotulos != -1]\n",
        "        tamanhos_clusters = pd.Series(clusters_validos).value_counts()\n",
        "\n",
        "        quantidade_clusters = len(tamanhos_clusters)\n",
        "\n",
        "        if quantidade_clusters > 0:\n",
        "            maior_cluster = tamanhos_clusters.max()\n",
        "            menor_cluster = tamanhos_clusters.min()\n",
        "            percentual_maior_cluster = maior_cluster / len(rotulos) * 100\n",
        "        else:\n",
        "            maior_cluster = 0\n",
        "            menor_cluster = 0\n",
        "            percentual_maior_cluster = 0\n",
        "\n",
        "        resumo_dbscan.append({\n",
        "            'eps': eps,\n",
        "            'min_samples': min_samples,\n",
        "            'quantidade_clusters': quantidade_clusters,\n",
        "            'registros_ruido': quantidade_ruido,\n",
        "            'percentual_ruido': percentual_ruido,\n",
        "            'maior_cluster': maior_cluster,\n",
        "            'percentual_maior_cluster': percentual_maior_cluster,\n",
        "            'menor_cluster': menor_cluster\n",
        "        })\n",
        "\n",
        "# Consolidar resultados\n",
        "df_resultados_dbscan = pd.DataFrame(resumo_dbscan)\n",
        "\n",
        "print(\"\\nRESUMO COMPARATIVO DOS PARÂMETROS\")\n",
        "display(\n",
        "    df_resultados_dbscan\n",
        "    .sort_values(['eps', 'min_samples'])\n",
        "    .round(2)\n",
        "    .reset_index(drop=True)\n",
        ")\n"
      ],
