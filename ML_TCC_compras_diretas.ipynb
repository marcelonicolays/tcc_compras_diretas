    {
      "cell_type": "markdown",
      "source": [
        "## Salvar resultados no Supabase"
      ],
      "metadata": {
        "id": "IFBGtEE9pWUG"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# 1. VALIDAR VARIÁVEIS E CONFIGURAÇÕES\n",
        "# ============================================================\n",
        "\n",
        "if 'engine' not in globals():\n",
        "    raise NameError(\"A conexão com o Supabase (engine) não foi encontrada.\")\n",
        "\n",
        "if 'df_ml' not in globals():\n",
        "    raise NameError(\"O DataFrame df_ml não foi encontrado.\")\n",
        "\n",
        "if 'resultados_min_samples' not in globals():\n",
        "    raise NameError(\"A variável resultados_min_samples não foi encontrada.\")\n",
        "\n",
        "if 10 not in resultados_min_samples:\n",
        "    raise KeyError(\"Não foram encontrados resultados do DBSCAN para min_samples=10.\")\n",
        "\n",
        "base = df_ml.reset_index(drop=True).copy()\n",
        "\n",
        "# Configurações definidas para os modelos\n",
        "CLUSTERS_PRIORITARIOS = [1, 2, 7, 9, 19]\n",
        "MIN_SAMPLES_DBSCAN = 10\n",
        "\n",
        "# Identificar a coluna dos clusters do K-Means\n",
        "coluna_cluster_kmeans = next(\n",
        "    (\n",
        "        coluna for coluna in [\n",
        "            'cluster_kmeans',\n",
        "            'cluster_kmeans_label',\n",
        "            'cluster'\n",
        "        ]\n",
        "        if coluna in base.columns\n",
        "    ),\n",
        "    None\n",
        ")\n",
        "\n",
        "if coluna_cluster_kmeans is None:\n",
        "    raise KeyError(\n",
        "        \"Não foi encontrada a coluna dos clusters do K-Means. \"\n",
        "        \"Verifique o nome da coluna no df_ml.\"\n",
        "    )\n",
        "\n",
        "# Validar colunas necessárias\n",
        "colunas_obrigatorias = [\n",
        "    'zscore_preco',\n",
        "    'score_anomalia_iforest'\n",
        "]\n",
        "\n",
        "for coluna in colunas_obrigatorias:\n",
        "    if coluna not in base.columns:\n",
        "        raise KeyError(f\"A coluna '{coluna}' não foi encontrada no df_ml.\")\n",
        "\n",
        "if 'anomalia_iforest' not in base.columns and 'iforest_pred' not in base.columns:\n",
        "    raise KeyError(\n",
        "        \"Não foi encontrada a coluna anomalia_iforest nem iforest_pred.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. OBTER O ID DE CADA ITEM NA TABELA itens_processo\n",
        "# ============================================================\n",
        "\n",
        "if 'iditens_processo' in base.columns:\n",
        "\n",
        "    # Caso o ID já esteja disponível no DataFrame\n",
        "    ids_itens = pd.to_numeric(\n",
        "        base['iditens_processo'],\n",
        "        errors='coerce'\n",
        "    )\n",
        "\n",
        "else:\n",
        "\n",
        "    # Caso seja necessário relacionar processo e item\n",
        "    colunas_chave = ['idprocesso', 'iditem']\n",
        "\n",
        "    if not all(coluna in base.columns for coluna in colunas_chave):\n",
        "        raise KeyError(\n",
        "            \"Para relacionar os registros com itens_processo, \"\n",
        "            \"o df_ml precisa conter idprocesso e iditem.\"\n",
        "        )\n",
        "\n",
        "    base['_ordem_original'] = np.arange(len(base))\n",
        "\n",
        "    with engine.connect() as conn:\n",
        "        df_ids = pd.read_sql_query(\n",
        "            text(\"\"\"\n",
        "                SELECT\n",
        "                    iditens_processo,\n",
        "                    processo_idprocesso,\n",
        "                    item_iditem\n",
        "                FROM public.itens_processo\n",
        "            \"\"\"),\n",
        "            conn\n",
        "        )\n",
        "\n",
        "    # Padronizar os tipos das chaves\n",
        "    base['idprocesso'] = pd.to_numeric(\n",
        "        base['idprocesso'], errors='coerce'\n",
        "    ).astype('Int64')\n",
        "\n",
        "    base['iditem'] = pd.to_numeric(\n",
        "        base['iditem'], errors='coerce'\n",
        "    ).astype('Int64')\n",
        "\n",
        "    df_ids['processo_idprocesso'] = pd.to_numeric(\n",
        "        df_ids['processo_idprocesso'], errors='coerce'\n",
        "    ).astype('Int64')\n",
        "\n",
        "    df_ids['item_iditem'] = pd.to_numeric(\n",
        "        df_ids['item_iditem'], errors='coerce'\n",
        "    ).astype('Int64')\n",
        "\n",
        "    if base[['idprocesso', 'iditem']].isna().any().any():\n",
        "        raise ValueError(\n",
        "            \"Existem valores ausentes nas chaves idprocesso ou iditem do df_ml.\"\n",
        "        )\n",
        "\n",
        "    # Relacionar os registros do modelo com os IDs do banco\n",
        "    base = base.merge(\n",
        "        df_ids,\n",
        "        left_on=['idprocesso', 'iditem'],\n",
        "        right_on=['processo_idprocesso', 'item_iditem'],\n",
        "        how='left',\n",
        "        validate='many_to_one',\n",
        "        sort=False\n",
        "    )\n",
        "\n",
        "    base = (\n",
        "        base.sort_values('_ordem_original')\n",
        "        .reset_index(drop=True)\n",
        "    )\n",
        "\n",
        "    ids_itens = pd.to_numeric(\n",
        "        base['iditens_processo'],\n",
        "        errors='coerce'\n",
        "    )\n",
        "\n",
        "\n",
        "# Validar os IDs encontrados\n",
        "if ids_itens.isna().any():\n",
        "    quantidade_sem_id = int(ids_itens.isna().sum())\n",
        "\n",
        "    raise ValueError(\n",
        "        f\"{quantidade_sem_id} registros não foram relacionados \"\n",
        "        \"a um iditens_processo no banco.\"\n",
        "    )\n",
        "\n",
        "ids_itens = ids_itens.astype('int64')\n",
        "\n",
        "if ids_itens.duplicated().any():\n",
        "    raise ValueError(\n",
        "        \"Existem IDs de itens duplicados no resultado. \"\n",
        "        \"Verifique o relacionamento antes de gravar.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. PREPARAR OS RESULTADOS DOS MODELOS\n",
        "# ============================================================\n",
        "\n",
        "# Converter valores booleanos de forma segura\n",
        "def converter_booleano(valor, permitir_nulo=False):\n",
        "\n",
        "    if pd.isna(valor):\n",
        "        if permitir_nulo:\n",
        "            return None\n",
        "        raise ValueError(\"Foi encontrado valor ausente em campo booleano obrigatório.\")\n",
        "\n",
        "    if isinstance(valor, str):\n",
        "        valor = valor.strip().lower()\n",
        "\n",
        "        if valor in ['true', '1', 't', 'sim', 's']:\n",
        "            return True\n",
        "\n",
        "        if valor in ['false', '0', 'f', 'não', 'nao', 'n']:\n",
        "            return False\n",
        "\n",
        "        raise ValueError(f\"Valor booleano não reconhecido: {valor}\")\n",
        "\n",
        "    return bool(valor)\n",
        "\n",
        "\n",
        "# Z-score\n",
        "zscore_preco = pd.to_numeric(\n",
        "    base['zscore_preco'],\n",
        "    errors='coerce'\n",
        ")\n",
        "\n",
        "if 'anomalia_zscore' in base.columns:\n",
        "\n",
        "    anomalia_zscore = [\n",
        "        converter_booleano(valor, permitir_nulo=True)\n",
        "        for valor in base['anomalia_zscore'].tolist()\n",
        "    ]\n",
        "\n",
        "else:\n",
        "\n",
