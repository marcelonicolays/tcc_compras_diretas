        "eps_fixo = 1.41\n",
        "valores_min_samples = [5, 10, 15, 20]\n",
        "\n",
        "resultados_min_samples = {}\n",
        "resumo_min_samples = []\n",
        "\n",
        "for ms in valores_min_samples:\n",
        "\n",
        "    print(f\"Testando min_samples={ms}...\")\n",
        "\n",
        "    # Reaproveitar os resultados anteriores, se disponíveis\n",
        "    if ms != 5:\n",
        "        try:\n",
        "            rotulos = resultados_dbscan_refino[(eps_fixo, ms)]\n",
        "        except (NameError, KeyError):\n",
        "            rotulos = DBSCAN(\n",
        "                eps=eps_fixo,\n",
        "                min_samples=ms,\n",
        "                metric='euclidean',\n",
        "                n_jobs=-1\n",
        "            ).fit_predict(X)\n",
        "    else:\n",
        "        rotulos = DBSCAN(\n",
        "            eps=eps_fixo,\n",
        "            min_samples=ms,\n",
        "            metric='euclidean',\n",
        "            n_jobs=-1\n",
        "        ).fit_predict(X)\n",
        "\n",
        "    resultados_min_samples[ms] = rotulos\n",
        "\n",
        "    # Estatísticas dos clusters\n",
        "    tamanhos = pd.Series(\n",
        "        rotulos[rotulos != -1]\n",
        "    ).value_counts()\n",
        "\n",
        "    ruido = np.sum(rotulos == -1)\n",
        "\n",
        "    resumo_min_samples.append({\n",
        "        'min_samples': ms,\n",
        "        'quantidade_clusters': len(tamanhos),\n",
        "        'registros_ruido': ruido,\n",
        "        'percentual_ruido': ruido / len(rotulos) * 100,\n",
        "        'maior_cluster': tamanhos.max() if len(tamanhos) else 0,\n",
        "        'percentual_maior_cluster': (\n",
        "            tamanhos.max() / len(rotulos) * 100\n",
        "            if len(tamanhos) else 0\n",
        "        ),\n",
        "        'mediana_tamanho_cluster': (\n",
        "            tamanhos.median() if len(tamanhos) else 0\n",
        "        )\n",
        "    })\n",
        "\n",
        "df_comparacao_min_samples = pd.DataFrame(\n",
        "    resumo_min_samples\n",
        ")\n",
        "\n",
        "display(df_comparacao_min_samples.round(2))\n"
