        "## DBSCAN"
      ],
      "metadata": {
        "id": "47vUZE-dUJud"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "* Definição dos parâmetros"
      ],
      "metadata": {
        "id": "IDcNqAzsnXPa"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Conferir a matriz utilizada\n",
        "if X.shape[0] != len(df_ml):\n",
        "    raise ValueError(\"X e df_ml possuem quantidades diferentes de registros.\")\n",
        "\n",
        "# Valores de min_samples que serão avaliados\n",
        "valores_min_samples = [10, 15, 20]\n",
        "\n",
        "# Calcular os vizinhos uma única vez, usando o maior valor\n",
        "vizinhos = NearestNeighbors(\n",
        "    n_neighbors=max(valores_min_samples),\n",
        "    metric='euclidean',\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "vizinhos.fit(X)\n",
        "\n",
        "distancias, _ = vizinhos.kneighbors(X)\n",
        "\n",
        "# Construir gráfico das distâncias ordenadas\n",
        "fig, ax = plt.subplots(figsize=(12, 6))\n",
        "\n",
        "for min_samples in valores_min_samples:\n",
        "\n",
        "    distancias_ordenadas = np.sort(\n",
        "        distancias[:, min_samples - 1]\n",
        "    )\n",
        "\n",
        "    ax.plot(\n",
        "        np.arange(1, len(distancias_ordenadas) + 1),\n",
        "        distancias_ordenadas,\n",
        "        label=f'min_samples = {min_samples}'\n",
        "    )\n",
        "\n",
        "ax.set_title('DBSCAN - Distância dos vizinhos mais próximos')\n",
        "ax.set_xlabel('Registros ordenados por distância')\n",
        "ax.set_ylabel('Distância Euclidiana')\n",
        "ax.legend()\n",
        "ax.grid(alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ],
