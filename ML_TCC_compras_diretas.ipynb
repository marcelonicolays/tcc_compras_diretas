    {
      "cell_type": "markdown",
      "source": [
        "## Exportando em .parquet"
      ],
      "metadata": {
        "id": "sJnJDJ1r-s2i"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# 1. VALIDAR CONEXÃO\n",
        "# ============================================================\n",
        "\n",
        "if 'engine' not in globals():\n",
        "    raise NameError(\"Conexão com o Supabase (engine) não encontrada.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. RECONSTRUIR A BASE DIRETAMENTE DO SUPABASE\n",
        "# ============================================================\n",
        "\n",
        "consulta = text(\"\"\"\n",
        "    SELECT\n",
        "        -- Identificadores\n",
        "        ip.iditens_processo,\n",
        "        p.idprocesso,\n",
        "        p.numero_processo,\n",
        "        p.ano_processo,\n",
        "\n",
        "        -- Dados do processo\n",
        "        p.data_aprovacao,\n",
        "        p.valor_processo,\n",
        "        p.objeto,\n",
        "        p.enquadramento,\n",
        "\n",
        "        -- Órgão\n",
        "        o.idorgao,\n",
        "        o.nome_orgao AS unidade,\n",
        "\n",
        "        -- Fornecedor\n",
        "        p.parte_idparte AS fornecedor_id,\n",
        "\n",
        "        COALESCE(\n",
        "            NULLIF(BTRIM(pj.razao_social), ''),\n",
        "            NULLIF(BTRIM(pj.nome_fantasia), ''),\n",
        "            'Fornecedor não identificado'\n",
        "        ) AS fornecedor,\n",
        "\n",
        "        -- Item\n",
        "        i.iditem,\n",
        "        i.descricao_item AS item,\n",
        "        ip.quantidade,\n",
        "        um.un_medida AS unidade_medida,\n",
        "        ip.valor_unitario,\n",
        "\n",
        "        -- Características da contratação\n",
        "        a.descricao_afastamento AS afastamento,\n",
        "        tc.descricao AS tipo_contratacao,\n",
        "\n",
        "        -- Resultados dos modelos\n",
        "        rm.idresultado_ml,\n",
        "        rm.zscore_preco,\n",
        "        rm.anomalia_zscore,\n",
        "        rm.cluster_kmeans,\n",
        "        rm.anomalia_kmeans,\n",
        "        rm.score_anomalia_iforest,\n",
        "        rm.anomalia_iforest,\n",
        "        rm.cluster_dbscan,\n",
        "        rm.anomalia_dbscan,\n",
        "        rm.data_execucao\n",
        "\n",
        "    FROM public.itens_processo AS ip\n",
        "\n",
        "    INNER JOIN public.processo AS p\n",
        "        ON p.idprocesso = ip.processo_idprocesso\n",
        "\n",
        "    INNER JOIN public.processo_compra_direta AS pcd\n",
        "        ON pcd.processo_idprocesso = p.idprocesso\n",
        "\n",
        "    LEFT JOIN public.orgao AS o\n",
        "        ON o.idorgao = p.orgao_idorgao\n",
        "\n",
        "    LEFT JOIN public.parte_pj AS pj\n",
        "        ON pj.parte_idparte = p.parte_idparte\n",
        "\n",
        "    LEFT JOIN public.item AS i\n",
        "        ON i.iditem = ip.item_iditem\n",
        "\n",
        "    LEFT JOIN public.un_medida AS um\n",
        "        ON um.idun_medida = i.un_medida_idun_medida\n",
        "\n",
        "    LEFT JOIN public.afastamento AS a\n",
        "        ON a.idafastamento = pcd.afastamento_idafastamento\n",
        "\n",
        "    LEFT JOIN public.tipo_contratacao AS tc\n",
        "        ON tc.idtipo_contratacao = p.tipo_contratacao_idtipo_contratacao\n",
        "\n",
        "    LEFT JOIN public.resultado_ml AS rm\n",
        "        ON rm.itens_processo_iditens_processo = ip.iditens_processo\n",
        "\n",
        "    ORDER BY\n",
        "        p.ano_processo,\n",
        "        p.idprocesso,\n",
        "        ip.iditens_processo\n",
        "\"\"\")\n",
        "\n",
        "print(\"Consultando e reconstruindo a base no Supabase...\")\n",
        "\n",
        "with engine.connect() as conn:\n",
        "    df_final = pd.read_sql_query(consulta, conn)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. VALIDAR A BASE RECONSTRUÍDA\n",
        "# ============================================================\n",
        "\n",
        "if df_final.empty:\n",
        "    raise ValueError(\"A consulta não retornou registros.\")\n",
        "\n",
        "if df_final['iditens_processo'].duplicated().any():\n",
        "    raise ValueError(\n",
        "        \"Foram encontrados itens duplicados. \"\n",
        "        \"Verifique os relacionamentos das tabelas.\"\n",
        "    )\n",
        "\n",
        "total_registros = len(df_final)\n",
        "\n",
        "registros_com_ml = int(\n",
        "    df_final['idresultado_ml'].notna().sum()\n",
        ")\n",
        "\n",
        "registros_sem_ml = total_registros - registros_com_ml\n",
        "\n",
        "print(\"\\nBase reconstruída com sucesso!\")\n",
        "print(f\"Total de registros: {total_registros:,}\")\n",
        "print(f\"Total de colunas: {len(df_final.columns)}\")\n",
        "print(f\"Registros com resultado ML: {registros_com_ml:,}\")\n",
        "print(f\"Registros sem resultado ML: {registros_sem_ml:,}\")\n",
        "\n",
        "if registros_sem_ml > 0:\n",
        "    print(\n",
        "        \"\\nATENÇÃO: existem itens sem correspondência \"\n",
        "        \"na tabela resultado_ml.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. GARANTIR A DISPONIBILIDADE DO PYARROW\n",
        "# ============================================================\n",
        "\n",
        "try:\n",
        "    import pyarrow\n",
        "\n",
        "except ImportError:\n",
        "\n",
        "    print(\"\\nInstalando pyarrow...\")\n",
        "\n",
        "    subprocess.check_call([\n",
        "        sys.executable,\n",
        "        \"-m\",\n",
        "        \"pip\",\n",
        "        \"install\",\n",
        "        \"-q\",\n",
        "        \"pyarrow\"\n",
        "    ])\n",
        "\n",
        "    import pyarrow\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. EXPORTAR PARA PARQUET\n",
        "# ============================================================\n",
        "\n",
        "arquivo_parquet = (\n",
        "    \"/content/base_compras_diretas_com_resultado_ml.parquet\"\n",
        ")\n",
        "\n",
        "df_final.to_parquet(\n",
        "    arquivo_parquet,\n",
        "    engine=\"pyarrow\",\n",
        "    compression=\"snappy\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. VALIDAR O ARQUIVO GERADO\n",
        "# ============================================================\n",
        "\n",
        "df_conferencia = pd.read_parquet(arquivo_parquet)\n",
        "\n",
        "assert len(df_conferencia) == len(df_final)\n",
        "assert list(df_conferencia.columns) == list(df_final.columns)\n",
        "\n",
        "tamanho_mb = os.path.getsize(arquivo_parquet) / (1024 ** 2)\n",
        "\n",
        "print(\"\\nExportação concluída e validada!\")\n",
        "print(f\"Arquivo: {arquivo_parquet}\")\n",
        "print(f\"Registros: {len(df_conferencia):,}\")\n",
        "print(f\"Colunas: {len(df_conferencia.columns)}\")\n",
        "print(f\"Tamanho: {tamanho_mb:.2f} MB\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. DISPONIBILIZAR DOWNLOAD\n",
        "# ============================================================\n",
        "\n",
        "files.download(arquivo_parquet)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 257
        },
        "id": "7s3rXcGQ-xBu",
        "outputId": "104b6b45-3d27-4f55-d94a-bb01eaa163eb"
      },
