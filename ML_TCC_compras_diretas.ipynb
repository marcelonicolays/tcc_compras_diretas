    {
      "cell_type": "markdown",
      "source": [
        "### Análise dos clusters"
      ],
      "metadata": {
        "id": "kXBQPCT9UKQD"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Conferir se X e df_ml possuem a mesma quantidade de registros\n",
        "if X.shape[0] != len(df_ml):\n",
        "    raise ValueError(\"X e df_ml possuem quantidades diferentes de registros.\")\n",
        "\n",
        "# Distância de cada registro ao centroide do próprio cluster\n",
        "rotulos = df_ml['cluster_kmeans'].to_numpy()\n",
        "distancias = modelo_kmeans.transform(X)\n",
        "\n",
        "df_ml['distancia_centroide_kmeans'] = distancias[\n",
        "    np.arange(len(df_ml)), rotulos\n",
        "]\n",
        "\n",
        "# Calcular o centro global no espaço das features utilizadas no modelo\n",
        "centro_global = np.asarray(X.mean(axis=0)).ravel()\n",
        "centros_clusters = modelo_kmeans.cluster_centers_\n",
        "\n",
        "# Distância de cada centroide ao centro global\n",
        "distancias_globais = np.linalg.norm(\n",
        "    centros_clusters - centro_global,\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "# Quantidade de registros por cluster\n",
        "n_clusters = modelo_kmeans.n_clusters\n",
        "\n",
        "tamanhos = (\n",
        "    df_ml['cluster_kmeans']\n",
        "    .value_counts()\n",
        "    .reindex(range(n_clusters), fill_value=0)\n",
        "    .to_numpy()\n",
        ")\n",
        "\n",
        "# Ajuste exploratório pelo tamanho do cluster\n",
        "score_divergencia = (\n",
        "    distancias_globais / np.log2(tamanhos + 2)\n",
        ")\n",
        "\n",
        "resumo_clusters = pd.DataFrame({\n",
        "    'cluster': np.arange(n_clusters),\n",
        "    'quantidade': tamanhos,\n",
        "    'distancia_centro_global': distancias_globais,\n",
        "    'score_divergencia_ajustado': score_divergencia\n",
        "})\n",
        "\n",
        "# Mostrar os clusters com maiores scores\n",
        "display(\n",
        "    resumo_clusters\n",
        "    .sort_values('score_divergencia_ajustado', ascending=False)\n",
        "    .round(3)\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "# Gráfico horizontal\n",
        "grafico = resumo_clusters.sort_values(\n",
        "    'score_divergencia_ajustado',\n",
        "    ascending=True\n",
        ")\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10, 7))\n",
        "\n",
        "barras = ax.barh(\n",
        "    grafico['cluster'].astype(str),\n",
        "    grafico['score_divergencia_ajustado']\n",
        ")\n",
        "\n",
        "ax.bar_label(barras, fmt='%.3f', padding=3, fontsize=8)\n",
        "ax.set_title(\n",
        "    'Distância dos centroides ao centro global ajustada pelo tamanho'\n",
        ")\n",
        "ax.set_xlabel('Score de divergência ajustado')\n",
        "ax.set_ylabel('Cluster')\n",
        "ax.grid(axis='x', alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ],
