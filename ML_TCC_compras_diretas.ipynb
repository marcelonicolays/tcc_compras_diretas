    {
      "cell_type": "code",
      "source": [
        "# Refinamento do intervalo de EPS\n",
        "valores_eps = np.round(np.arange(1.40, 1.501, 0.01), 2)\n",
        "valores_min_samples = [10, 15, 20]\n",
        "\n",
        "resultados_dbscan_refino = {}\n",
        "resumo_refino = []\n",
        "\n",
        "for eps in valores_eps:\n",
        "\n",
        "    for min_samples in valores_min_samples:\n",
        "\n",
        "        print(f\"EPS={eps:.2f} | min_samples={min_samples}\")\n",
        "\n",
        "        modelo = DBSCAN(\n",
        "            eps=eps,\n",
        "            min_samples=min_samples,\n",
        "            metric='euclidean',\n",
        "            n_jobs=-1\n",
        "        )\n",
        "\n",
        "        rotulos = modelo.fit_predict(X)\n",
        "\n",
        "        resultados_dbscan_refino[(eps, min_samples)] = rotulos\n",
        "\n",
        "        # Excluir ruídos para analisar os clusters\n",
        "        tamanhos = pd.Series(\n",
        "            rotulos[rotulos != -1]\n",
        "        ).value_counts()\n",
        "\n",
        "        quantidade_ruido = np.sum(rotulos == -1)\n",
        "\n",
        "        if len(tamanhos) > 0:\n",
        "\n",
        "            maior_cluster = tamanhos.max()\n",
        "            mediana_cluster = tamanhos.median()\n",
        "\n",
        "            clusters_maiores_50 = (tamanhos >= 50).sum()\n",
        "\n",
        "            registros_clusters_maiores_50 = (\n",
        "                tamanhos[tamanhos >= 50].sum()\n",
        "            )\n",
        "\n",
        "        else:\n",
        "            maior_cluster = 0\n",
        "            mediana_cluster = 0\n",
        "            clusters_maiores_50 = 0\n",
        "            registros_clusters_maiores_50 = 0\n",
        "\n",
        "        resumo_refino.append({\n",
        "            'eps': eps,\n",
        "            'min_samples': min_samples,\n",
        "            'quantidade_clusters': len(tamanhos),\n",
        "            'registros_ruido': quantidade_ruido,\n",
        "            'percentual_ruido': (\n",
        "                quantidade_ruido / len(df_ml) * 100\n",
        "            ),\n",
        "            'maior_cluster': maior_cluster,\n",
        "            'percentual_maior_cluster': (\n",
        "                maior_cluster / len(df_ml) * 100\n",
        "            ),\n",
        "            'mediana_tamanho_cluster': mediana_cluster,\n",
        "            'clusters_com_50_ou_mais': clusters_maiores_50,\n",
        "            'registros_em_clusters_50_ou_mais': (\n",
        "                registros_clusters_maiores_50\n",
        "            )\n",
        "        })\n",
        "\n",
        "df_refino_dbscan = pd.DataFrame(resumo_refino)\n",
        "\n",
        "display(\n",
        "    df_refino_dbscan\n",
        "    .round(2)\n",
        "    .sort_values(['min_samples', 'eps'])\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "# Gráfico de evolução do ruído e do maior cluster\n",
        "fig, eixos = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "for min_samples in valores_min_samples:\n",
        "\n",
        "    dados = df_refino_dbscan[\n",
        "        df_refino_dbscan['min_samples'] == min_samples\n",
        "    ]\n",
        "\n",
        "    eixos[0].plot(\n",
        "        dados['eps'],\n",
        "        dados['percentual_ruido'],\n",
        "        marker='o',\n",
        "        label=f'min_samples={min_samples}'\n",
        "    )\n",
        "\n",
        "    eixos[1].plot(\n",
        "        dados['eps'],\n",
        "        dados['percentual_maior_cluster'],\n",
        "        marker='o',\n",
        "        label=f'min_samples={min_samples}'\n",
        "    )\n",
        "\n",
        "eixos[0].set_title('Percentual de registros classificados como ruído')\n",
        "eixos[0].set_xlabel('EPS')\n",
        "eixos[0].set_ylabel('Ruído (%)')\n",
        "eixos[0].grid(alpha=0.3)\n",
        "eixos[0].legend()\n",
        "\n",
