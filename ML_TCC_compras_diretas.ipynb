>>>>>>> f347f85cf0dfa8329d6d8920bea9470702a743e6
        "        for valor in zscore_preco.tolist()\n",
        "    ]\n",
        "\n",
        "\n",
        "# K-Means\n",
        "cluster_kmeans = pd.to_numeric(\n",
        "    base[coluna_cluster_kmeans],\n",
        "    errors='coerce'\n",
        ")\n",
        "\n",
        "if cluster_kmeans.isna().any():\n",
        "    raise ValueError(\"Existem clusters K-Means ausentes ou inválidos.\")\n",
        "\n",
        "cluster_kmeans = cluster_kmeans.astype('int64')\n",
        "\n",
        "anomalia_kmeans = [\n",
        "    bool(valor in CLUSTERS_PRIORITARIOS)\n",
        "    for valor in cluster_kmeans.tolist()\n",
        "]\n",
        "\n",
        "\n",
        "# Isolation Forest\n",
        "if 'anomalia_iforest' in base.columns:\n",
        "\n",
        "    anomalia_iforest = [\n",
        "        converter_booleano(valor)\n",
        "        for valor in base['anomalia_iforest'].tolist()\n",
        "    ]\n",
        "\n",
        "else:\n",
        "\n",
        "    anomalia_iforest = [\n",
        "        bool(valor == -1)\n",
        "        for valor in base['iforest_pred'].tolist()\n",
        "    ]\n",
        "\n",
        "score_anomalia_iforest = pd.to_numeric(\n",
        "    base['score_anomalia_iforest'],\n",
        "    errors='coerce'\n",
        ")\n",
        "\n",
        "\n",
        "# DBSCAN - configuração final: min_samples=10\n",
        "labels_dbscan = np.asarray(\n",
        "    resultados_min_samples[MIN_SAMPLES_DBSCAN]\n",
        ").reshape(-1)\n",
        "\n",
        "if len(labels_dbscan) != len(base):\n",
        "    raise ValueError(\n",
        "        \"A quantidade de resultados do DBSCAN não corresponde \"\n",
        "        \"à quantidade de registros do df_ml.\"\n",
        "    )\n",
        "\n",
        "labels_dbscan = pd.to_numeric(\n",
        "    pd.Series(labels_dbscan),\n",
        "    errors='coerce'\n",
        ")\n",
        "\n",
        "if labels_dbscan.isna().any():\n",
        "    raise ValueError(\"Foram encontrados rótulos DBSCAN ausentes ou inválidos.\")\n",
        "\n",
        "cluster_dbscan = labels_dbscan.astype('int64')\n",
        "\n",
        "anomalia_dbscan = [\n",
        "    bool(valor == -1)\n",
        "    for valor in cluster_dbscan.tolist()\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. MONTAR O DATAFRAME PARA A TABELA resultado_ml\n",
        "# ============================================================\n",
        "\n",
        "df_resultados_ml = pd.DataFrame({\n",
        "\n",
        "    'itens_processo_iditens_processo': ids_itens.tolist(),\n",
        "\n",
        "    'zscore_preco': zscore_preco.tolist(),\n",
        "\n",
        "    'anomalia_zscore': anomalia_zscore,\n",
        "\n",
        "    'cluster_kmeans': cluster_kmeans.tolist(),\n",
        "\n",
        "    'anomalia_kmeans': anomalia_kmeans,\n",
        "\n",
        "    'score_anomalia_iforest': score_anomalia_iforest.tolist(),\n",
        "\n",
        "    'anomalia_iforest': anomalia_iforest,\n",
        "\n",
        "    'cluster_dbscan': cluster_dbscan.tolist(),\n",
        "\n",
        "    'anomalia_dbscan': anomalia_dbscan\n",
        "\n",
        "})\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. CONVERTER VALORES NUMPY/PANDAS PARA TIPOS PYTHON\n",
        "# ============================================================\n",
        "\n",
        "def converter_valor_sql(valor):\n",
        "\n",
        "    if valor is None or pd.isna(valor):\n",
        "        return None\n",
        "\n",
        "    if isinstance(valor, np.generic):\n",
        "        return valor.item()\n",
        "\n",
        "    return valor\n",
        "\n",
        "\n",
        "registros = [\n",
        "    {\n",
        "        coluna: converter_valor_sql(valor)\n",
        "        for coluna, valor in registro.items()\n",
        "    }\n",
        "    for registro in df_resultados_ml.to_dict('records')\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. INSERIR OU ATUALIZAR OS RESULTADOS NO SUPABASE\n",
        "# ============================================================\n",
        "\n",
        "sql_upsert = text(\"\"\"\n",
        "    INSERT INTO public.resultado_ml (\n",
        "        itens_processo_iditens_processo,\n",
        "        zscore_preco,\n",
        "        anomalia_zscore,\n",
        "        cluster_kmeans,\n",
        "        anomalia_kmeans,\n",
        "        score_anomalia_iforest,\n",
        "        anomalia_iforest,\n",
        "        cluster_dbscan,\n",
        "        anomalia_dbscan\n",
        "    )\n",
        "    VALUES (\n",
        "        :itens_processo_iditens_processo,\n",
        "        :zscore_preco,\n",
        "        :anomalia_zscore,\n",
        "        :cluster_kmeans,\n",
        "        :anomalia_kmeans,\n",
        "        :score_anomalia_iforest,\n",
        "        :anomalia_iforest,\n",
        "        :cluster_dbscan,\n",
        "        :anomalia_dbscan\n",
        "    )\n",
        "    ON CONFLICT (itens_processo_iditens_processo)\n",
        "    DO UPDATE SET\n",
        "\n",
        "        zscore_preco = EXCLUDED.zscore_preco,\n",
        "\n",
        "        anomalia_zscore = EXCLUDED.anomalia_zscore,\n",
        "\n",
        "        cluster_kmeans = EXCLUDED.cluster_kmeans,\n",
        "\n",
        "        anomalia_kmeans = EXCLUDED.anomalia_kmeans,\n",
        "\n",
        "        score_anomalia_iforest = EXCLUDED.score_anomalia_iforest,\n",
        "\n",
        "        anomalia_iforest = EXCLUDED.anomalia_iforest,\n",
        "\n",
        "        cluster_dbscan = EXCLUDED.cluster_dbscan,\n",
        "\n",
        "        anomalia_dbscan = EXCLUDED.anomalia_dbscan,\n",
        "\n",
        "        data_execucao = NOW()\n",
        "\"\"\")\n",
        "\n",
        "# Gravar em lotes, dentro de uma única transação\n",
        "lote = 1000\n",
        "\n",
        "with engine.begin() as conn:\n",
        "\n",
        "    for inicio in range(0, len(registros), lote):\n",
        "\n",
        "        fim = inicio + lote\n",
        "\n",
        "        conn.execute(\n",
        "            sql_upsert,\n",
        "            registros[inicio:fim]\n",
        "        )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. CONFERIR OS RESULTADOS GRAVADOS\n",
        "# ============================================================\n",
        "\n",
        "with engine.connect() as conn:\n",
        "\n",
        "    resumo_resultados = pd.read_sql_query(\n",
        "        text(\"\"\"\n",
        "            SELECT\n",
        "                COUNT(*) AS total_registros,\n",
        "\n",
        "                COUNT(*) FILTER (\n",
        "                    WHERE anomalia_zscore IS TRUE\n",
        "                ) AS sinalizados_zscore,\n",
        "\n",
        "                COUNT(*) FILTER (\n",
        "                    WHERE anomalia_zscore IS NULL\n",
        "                ) AS nao_avaliaveis_zscore,\n",
        "\n",
        "                COUNT(*) FILTER (\n",
        "                    WHERE anomalia_kmeans IS TRUE\n",
        "                ) AS sinalizados_kmeans,\n",
        "\n",
        "                COUNT(*) FILTER (\n",
        "                    WHERE anomalia_iforest IS TRUE\n",
        "                ) AS sinalizados_iforest,\n",
        "\n",
        "                COUNT(*) FILTER (\n",
        "                    WHERE anomalia_dbscan IS TRUE\n",
        "                ) AS sinalizados_dbscan\n",
        "\n",
        "            FROM public.resultado_ml\n",
        "        \"\"\"),\n",
        "        conn\n",
        "    )\n",
        "\n",
        "\n",
        "print(f\"Registros preparados: {len(df_resultados_ml):,}\")\n",
        "print(\"Gravação concluída com sucesso!\")\n",
        "print(\"\\nResumo da tabela resultado_ml:\")\n",
        "\n",
        "display(resumo_resultados)"
      ],
