        "### Montar base analítica"
      ],
      "metadata": {
        "id": "BUP6ppoxe6VF"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "consulta_base_ml = \"\"\"\n",
        "SELECT\n",
        "    ip.iditens_processo,\n",
        "    p.idprocesso,\n",
        "    p.numero_processo,\n",
        "    p.ano_processo,\n",
        "    p.data_aprovacao,\n",
        "    p.valor_processo,\n",
        "    p.objeto,\n",
        "    p.enquadramento,\n",
        "\n",
        "    o.idorgao,\n",
        "    o.nome_orgao AS unidade,\n",
        "\n",
        "    p.parte_idparte AS fornecedor_id,\n",
        "    COALESCE(\n",
        "        NULLIF(BTRIM(pj.razao_social), ''),\n",
        "        NULLIF(BTRIM(pj.nome_fantasia), ''),\n",
        "        'Fornecedor não identificado'\n",
        "    ) AS fornecedor,\n",
        "\n",
        "    i.iditem,\n",
        "    i.descricao_item AS item,\n",
        "    ip.quantidade,\n",
        "    um.un_medida AS unidade_medida,\n",
        "    ip.valor_unitario,\n",
        "\n",
        "    a.descricao_afastamento AS afastamento,\n",
        "    tc.descricao AS tipo_contratacao\n",
        "\n",
        "FROM public.itens_processo AS ip\n",
        "\n",
        "INNER JOIN public.processo AS p\n",
        "    ON p.idprocesso = ip.processo_idprocesso\n",
        "\n",
        "INNER JOIN public.processo_compra_direta AS pcd\n",
        "    ON pcd.processo_idprocesso = p.idprocesso\n",
        "\n",
        "LEFT JOIN public.orgao AS o\n",
        "    ON o.idorgao = p.orgao_idorgao\n",
        "\n",
        "LEFT JOIN public.parte_pj AS pj\n",
        "    ON pj.parte_idparte = p.parte_idparte\n",
        "\n",
        "LEFT JOIN public.item AS i\n",
        "    ON i.iditem = ip.item_iditem\n",
        "\n",
        "LEFT JOIN public.un_medida AS um\n",
        "    ON um.idun_medida = i.un_medida_idun_medida\n",
        "\n",
        "LEFT JOIN public.afastamento AS a\n",
        "    ON a.idafastamento = pcd.afastamento_idafastamento\n",
        "\n",
        "LEFT JOIN public.tipo_contratacao AS tc\n",
        "    ON tc.idtipo_contratacao = p.tipo_contratacao_idtipo_contratacao\n",
        "\n",
        "ORDER BY p.ano_processo, p.idprocesso, ip.iditens_processo\n",
        "\"\"\"\n",
        "\n",
        "with engine.connect() as conn:\n",
        "    df_ml_base = pd.read_sql_query(\n",
        "        text(consulta_base_ml),\n",
        "        conn\n",
        "    )\n",
        "\n",
        "# Ajustar os tipos numéricos\n",
        "for coluna in ['valor_processo', 'quantidade', 'valor_unitario']:\n",
        "    df_ml_base[coluna] = pd.to_numeric(\n",
        "        df_ml_base[coluna],\n",
        "        errors='coerce'\n",
        "    )\n",
        "\n",
        "df_ml_base['data_aprovacao'] = pd.to_datetime(\n",
        "    df_ml_base['data_aprovacao'],\n",
        "    errors='coerce'\n",
        ")\n",
        "\n",
        "print(f\"Registros de itens: {len(df_ml_base):,}\")\n",
        "print(f\"Processos distintos: {df_ml_base['idprocesso'].nunique():,}\")\n",
        "print(f\"Itens distintos: {df_ml_base['iditens_processo'].nunique():,}\")\n",
        "print(f\"Processos sem órgão identificado: {df_ml_base['unidade'].isna().sum():,}\")\n",
        "print(f\"Itens sem fornecedor identificado: \"\n",
        "      f\"{df_ml_base['fornecedor'].eq('Fornecedor não identificado').sum():,}\")\n",
