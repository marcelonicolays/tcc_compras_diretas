      "cell_type": "markdown",
      "source": [
        "### Consultar tabelas e verificar os dados"
      ],
      "metadata": {
        "id": "GeoK8yq6d7xL"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Identifica o schema atual\n",
        "with engine.connect() as conn:\n",
        "    schema = conn.execute(\n",
        "        text(\"SELECT current_schema()\")\n",
        "    ).scalar_one()\n",
        "\n",
        "    print(f\"Banco de dados: {conn.execute(text('SELECT current_database()')).scalar_one()}\")\n",
        "    print(f\"Schema consultado: {schema}\")\n",
        "\n",
        "    # Lista as tabelas existentes\n",
        "    df_tabelas = pd.read_sql_query(\n",
        "        text(\"\"\"\n",
        "            SELECT table_name\n",
        "            FROM information_schema.tables\n",
        "            WHERE table_schema = :schema\n",
        "              AND table_type = 'BASE TABLE'\n",
        "            ORDER BY table_name\n",
        "        \"\"\"),\n",
        "        conn,\n",
        "        params={\"schema\": schema}\n",
        "    )\n",
        "\n",
        "    # Consulta a quantidade de registros de cada tabela\n",
        "    tabelas_info = []\n",
        "\n",
        "    preparador = engine.dialect.identifier_preparer\n",
        "    schema_sql = preparador.quote(schema)\n",
        "\n",
        "    for tabela in df_tabelas[\"table_name\"]:\n",
        "        tabela_sql = preparador.quote(tabela)\n",
        "\n",
        "        quantidade = conn.execute(\n",
        "            text(f\"SELECT COUNT(*) FROM {schema_sql}.{tabela_sql}\")\n",
        "        ).scalar_one()\n",
        "\n",
        "        tabelas_info.append({\n",
        "            \"Tabela\": tabela,\n",
        "            \"Quantidade_registros\": quantidade\n",
        "        })\n",
        "\n",
        "    df_resumo_tabelas = pd.DataFrame(tabelas_info)\n",
        "\n",
        "    # Consulta as colunas e seus tipos no PostgreSQL\n",
        "    df_colunas_sql = pd.read_sql_query(\n",
        "        text(\"\"\"\n",
        "            SELECT\n",
        "                table_name AS tabela,\n",
        "                ordinal_position AS ordem,\n",
        "                column_name AS coluna,\n",
        "                data_type AS tipo_dado,\n",
        "                udt_name AS tipo_postgresql,\n",
        "                is_nullable AS aceita_nulo\n",
        "            FROM information_schema.columns\n",
        "            WHERE table_schema = :schema\n",
        "            ORDER BY table_name, ordinal_position\n",
        "        \"\"\"),\n",
        "        conn,\n",
        "        params={\"schema\": schema}\n",
        "    )\n",
        "\n",
        "# Apresenta os resultados\n",
        "print(\"\\n=== TABELAS E QUANTIDADE DE REGISTROS ===\")\n",
        "display(df_resumo_tabelas)\n",
        "\n",
        "print(\"\\n=== COLUNAS E TIPOS DE DADOS ===\")\n",
        "display(df_colunas_sql)\n",
        "\n",
        "print(f\"\\nTotal de tabelas encontradas: {len(df_resumo_tabelas)}\")\n",
        "print(f\"Total de colunas encontradas: {len(df_colunas_sql)}\")"
      ],
