        "* Criar anomalia_kmeans"
      ],
      "metadata": {
        "id": "KqqYTAcGYK6-"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# DEFINIÇÃO E MARCAÇÃO DOS CLUSTERS ANÔMALOS\n",
        "\n",
        "# Clusters definidos na análise anterior: C1, C2, C7, C9 e C19\n",
        "clusters_anomalos = [1, 2, 7, 9, 19]\n",
        "\n",
        "# Cria a flag binária (1 = Anomalia, 0 = Normal)\n",
        "df_ml['anomalia_kmeans'] = df_ml['cluster_kmeans'].isin(clusters_anomalos).astype(int)\n",
        "\n",
        "print(\"RESULTADOS DO K-MEANS COMO DETECTOR DE ANOMALIAS\")\n",
        "\n",
        "# CÁLCULO DOS TOTAIS GERAIS\n",
        "\n",
        "total_itens = len(df_ml)\n",
        "itens_anomalos = int(df_ml['anomalia_kmeans'].sum())\n",
        "\n",
        "total_processos = df_ml['idprocesso'].nunique()\n",
        "# Processos que possuem pelo menos 1 item anômalo\n",
        "processos_impactados = df_ml.loc[df_ml['anomalia_kmeans'] == 1, 'idprocesso'].nunique()\n",
        "\n",
        "\n",
        "# EXIBIÇÃO DOS RESULTADOS\n",
        "\n",
        "print(f\"Clusters marcados como anômalos: {clusters_anomalos}\\n\")\n",
        "\n",
        "print(\"--- NÍVEL DE ITENS ---\")\n",
        "print(f\"Total de itens na base: {total_itens:,}\")\n",
        "print(f\"Itens marcados como anômalos: {itens_anomalos:,}\")\n",
        "print(f\"Percentual de itens anômalos: {(itens_anomalos / total_itens) * 100:.2f}%\")\n",
        "\n",
        "print(\"\\n--- NÍVEL DE PROCESSOS ---\")\n",
        "print(f\"Total de processos únicos: {total_processos:,}\")\n",
        "print(f\"Processos com pelo menos 1 item anômalo: {processos_impactados:,}\")\n",
        "print(f\"Percentual de processos impactados: {(processos_impactados / total_processos) * 100:.2f}%\")\n",
        "\n",
        "\n",
        "# PROCESSOS 100% ANÔMALOS\n",
        "\n",
        "# Agrupa por processo para ver quais têm 100% dos itens marcados\n",
        "resumo_proc_kmeans = (\n",
        "    df_ml.groupby('idprocesso')\n",
        "    .agg(\n",
        "        total_itens=('anomalia_kmeans', 'size'),\n",
        "        itens_anomalos=('anomalia_kmeans', 'sum')\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "processos_100_anomalos = len(\n",
        "    resumo_proc_kmeans[\n",
        "        resumo_proc_kmeans['itens_anomalos'] == resumo_proc_kmeans['total_itens']\n",
        "    ]\n",
        ")\n",
        "\n",
        "print(f\"\\nProcessos com 100% dos itens anômalos: {processos_100_anomalos:,}\")"
      ],
