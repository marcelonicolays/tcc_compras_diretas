        "## Criar tabela ml_resultados no Supabase"
      ],
      "metadata": {
        "id": "d3QxH8slpKjH"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Criação da tabela no Supabase\n",
        "sql_criar_tabela = \"\"\"\n",
        "CREATE TABLE IF NOT EXISTS public.resultado_ml (\n",
        "    idresultado_ml SERIAL PRIMARY KEY,\n",
        "\n",
        "    -- Chave estrangeira para o item\n",
        "    itens_processo_iditens_processo INTEGER NOT NULL UNIQUE\n",
        "        REFERENCES public.itens_processo(iditens_processo)\n",
        "        ON DELETE CASCADE,\n",
        "\n",
        "    -- 1. Z-Score\n",
        "    zscore_preco NUMERIC(18,6),\n",
        "    anomalia_zscore BOOLEAN,\n",
        "\n",
        "    -- 2. K-Means\n",
        "    cluster_kmeans INTEGER,\n",
        "    anomalia_kmeans BOOLEAN NOT NULL DEFAULT FALSE,\n",
        "\n",
        "    -- 3. Isolation Forest\n",
        "    score_anomalia_iforest NUMERIC(18,6),\n",
        "    anomalia_iforest BOOLEAN NOT NULL DEFAULT FALSE,\n",
        "\n",
        "    -- 4. DBSCAN\n",
        "    cluster_dbscan INTEGER,\n",
        "    anomalia_dbscan BOOLEAN NOT NULL DEFAULT FALSE,\n",
        "\n",
        "    -- Auditoria\n",
        "    data_execucao TIMESTAMPTZ NOT NULL DEFAULT NOW()\n",
        ");\n",
        "\"\"\"\n",
        "\n",
        "# Executar criação e confirmar transação\n",
        "with engine.begin() as conn:\n",
        "    conn.execute(text(sql_criar_tabela))\n",
        "\n",
        "    # Consultar estrutura criada\n",
        "    resultado = conn.execute(text(\"\"\"\n",
        "        SELECT\n",
        "            column_name,\n",
        "            data_type,\n",
        "            is_nullable\n",
        "        FROM information_schema.columns\n",
        "        WHERE table_schema = 'public'\n",
        "          AND table_name = 'resultado_ml'\n",
        "        ORDER BY ordinal_position;\n",
        "    \"\"\"))\n",
        "\n",
        "    colunas = resultado.fetchall()\n",
        "\n",
        "# Exibir confirmação\n",
        "print(\"Tabela resultado_ml criada ou já existente no Supabase.\")\n",
        "print(f\"Total de colunas: {len(colunas)}\")\n",
        "\n",
        "df_estrutura = pd.DataFrame(\n",
        "    colunas,\n",
        "    columns=['Coluna', 'Tipo de dado', 'Aceita NULL']\n",
        ")\n",
        "\n",
        "display(df_estrutura)"
      ],
