      "cell_type": "markdown",
      "source": [
        "### Preparação das variáveis"
      ],
      "metadata": {
        "id": "JTUq7lrgh8tP"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# PREPARAÇÃO DA BASE\n",
        "\n",
        "df_ml = df_ml_base.copy()\n",
        "\n",
        "colunas_necessarias = [\n",
        "    'idprocesso',\n",
        "    'fornecedor_id',\n",
        "    'idorgao',\n",
        "    'valor_processo',\n",
        "    'valor_unitario',\n",
        "    'quantidade',\n",
        "    'afastamento',\n",
        "    'unidade'\n",
        "]\n",
        "\n",
        "faltantes = [\n",
        "    coluna for coluna in colunas_necessarias\n",
        "    if coluna not in df_ml.columns\n",
        "]\n",
        "\n",
        "if faltantes:\n",
        "    raise ValueError(\n",
        "        f\"Colunas necessárias não encontradas: {faltantes}\"\n",
        "    )\n",
        "\n",
        "print(f\"Registros de itens: {len(df_ml):,}\")\n",
        "\n",
        "# AGREGAÇÕES DO FORNECEDOR\n",
        "\n",
        "\n",
        "print(\"\\nCalculando os agregados dos fornecedores...\")\n",
        "\n",
        "# Número de órgãos distintos atendidos por fornecedor\n",
        "agg_forn = (\n",
        "    df_ml.groupby('fornecedor_id', dropna=False)\n",
        "    .agg(\n",
        "        n_orgaos_fornecedor=('idorgao', 'nunique')\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "# Número de processos distintos por fornecedor e órgão\n",
        "# Evita contar várias linhas do mesmo processo como\n",
        "# contratações diferentes.\n",
        "agg_forn_orgao = (\n",
        "    df_ml.groupby(\n",
        "        ['fornecedor_id', 'idorgao'],\n",
        "        dropna=False\n",
        "    )\n",
        "    .agg(\n",
        "        freq_fornecedor_orgao=('idprocesso', 'nunique')\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "# Remover versões anteriores, caso existam na base\n",
        "df_ml = df_ml.drop(\n",
        "    columns=[\n",
        "        'n_orgaos_fornecedor',\n",
        "        'freq_fornecedor_orgao'\n",
        "    ],\n",
        "    errors='ignore'\n",
        ")\n",
        "\n",
        "# Incorporar os agregados sem alterar a quantidade de linhas\n",
        "df_ml = df_ml.merge(\n",
        "    agg_forn,\n",
        "    on='fornecedor_id',\n",
        "    how='left',\n",
        "    validate='many_to_one'\n",
        ")\n",
        "\n",
        "df_ml = df_ml.merge(\n",
        "    agg_forn_orgao,\n",
        "    on=['fornecedor_id', 'idorgao'],\n",
        "    how='left',\n",
        "    validate='many_to_one'\n",
        ")\n",
        "\n",
        "if len(df_ml) != len(df_ml_base):\n",
        "    raise ValueError(\n",
        "        \"A quantidade de registros mudou após as agregações.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# VALIDAÇÃO E TRANSFORMAÇÕES NUMÉRICAS\n",
        "\n",
        "print(\"\\nValidando as variáveis numéricas...\")\n",
        "\n",
        "colunas_originais_num = [\n",
        "    'valor_processo',\n",
        "    'valor_unitario',\n",
        "    'quantidade'\n",
        "]\n",
        "\n",
        "for coluna in colunas_originais_num:\n",
        "    df_ml[coluna] = pd.to_numeric(\n",
        "        df_ml[coluna],\n",
        "        errors='coerce'\n",
        "    )\n",
        "\n",
        "# Verificar valores ausentes\n",
        "ausentes = df_ml[colunas_originais_num].isna().sum()\n",
        "\n",
        "if ausentes.any():\n",
        "    raise ValueError(\n",
        "        \"Existem valores ausentes ou não numéricos:\\n\"\n",
        "        f\"{ausentes[ausentes > 0]}\"\n",
        "    )\n",
        "\n",
        "# Verificar valores infinitos\n",
        "if not np.isfinite(\n",
        "    df_ml[colunas_originais_num].to_numpy(dtype=float)\n",
        ").all():\n",
        "    raise ValueError(\n",
        "        \"Existem valores infinitos nas variáveis numéricas.\"\n",
        "    )\n",
        "\n",
        "# Verificar valores negativos antes de aplicar log1p\n",
        "negativos = (df_ml[colunas_originais_num] < 0).sum()\n",
        "\n",
        "if negativos.any():\n",
        "    raise ValueError(\n",
        "        \"Existem valores negativos que precisam ser avaliados:\\n\"\n",
        "        f\"{negativos[negativos > 0]}\"\n",
        "    )\n",
        "\n",
        "# Aplicar log1p: ln(1 + x)\n",
        "df_ml['log_valor_processo'] = np.log1p(\n",
        "    df_ml['valor_processo']\n",
        ")\n",
        "\n",
        "df_ml['log_valor_unitario'] = np.log1p(\n",
        "    df_ml['valor_unitario']\n",
        ")\n",
        "\n",
        "df_ml['log_quantidade'] = np.log1p(\n",
        "    df_ml['quantidade']\n",
        ")\n",
        "\n",
        "\n",
        "# DEFINIÇÃO DAS FEATURES\n",
        "\n",
        "features_num = [\n",
        "    'log_valor_processo',\n",
        "    'log_valor_unitario',\n",
        "    'log_quantidade',\n",
        "    'n_orgaos_fornecedor',\n",
        "    'freq_fornecedor_orgao'\n",
        "]\n",
        "\n",
        "features_cat = [\n",
        "    'afastamento',\n",
        "    'unidade'\n",
        "]\n",
        "\n",
        "# Garantir que as categorias estejam preenchidas\n",
        "for coluna in features_cat:\n",
        "    df_ml[coluna] = (\n",
        "        df_ml[coluna]\n",
        "        .astype('string')\n",
        "        .fillna('NÃO IDENTIFICADO')\n",
        "        .astype(str)\n",
        "    )\n",
        "\n",
        "\n",
        "# PRÉ-PROCESSAMENTO\n",
        "\n",
        "# Compatibilidade com diferentes versões do scikit-learn\n",
        "try:\n",
        "    encoder = OneHotEncoder(\n",
        "        handle_unknown='ignore',\n",
        "        sparse_output=True\n",
        "    )\n",
        "except TypeError:\n",
        "    encoder = OneHotEncoder(\n",
        "        handle_unknown='ignore',\n",
        "        sparse=True\n",
        "    )\n",
        "\n",
        "preprocessor = ColumnTransformer(\n",
        "    transformers=[\n",
        "        (\n",
        "            'num',\n",
        "            RobustScaler(),\n",
        "            features_num\n",
        "        ),\n",
        "        (\n",
        "            'cat',\n",
        "            encoder,\n",
        "            features_cat\n",
        "        )\n",
        "    ],\n",
        "    remainder='drop',\n",
        "    sparse_threshold=1.0\n",
        ")\n",
        "\n",
        "# Criar a matriz de features\n",
        "X = preprocessor.fit_transform(\n",
        "    df_ml[features_num + features_cat]\n",
        ")\n",
        "\n",
        "# Manter a matriz esparsa quando aplicável\n",
        "if sparse.issparse(X):\n",
        "    X = X.tocsr()\n",
        "\n",
        "# Nomes das colunas geradas pelo pré-processamento\n",
        "nomes_features_ml = preprocessor.get_feature_names_out()\n",
        "\n",
        "\n",
        "# CONFERÊNCIA FINAL\n",
        "\n",
        "print(\"\\nPreparação concluída.\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "print(f\"Linhas da base: {len(df_ml):,}\")\n",
        "print(f\"Features numéricas: {len(features_num)}\")\n",
        "print(f\"Variáveis categóricas originais: {len(features_cat)}\")\n",
        "print(f\"Total de colunas após o encoding: {X.shape[1]:,}\")\n",
        "print(f\"Dimensões da matriz X: {X.shape}\")\n",
        "print(\n",
        "    \"Formato da matriz:\",\n",
        "    \"esparsa\" if sparse.issparse(X) else \"densa\"\n",
        ")\n",
        "\n",
        "print(\"\\nFeatures numéricas:\")\n",
        "for coluna in features_num:\n",
        "    print(f\" - {coluna}\")\n",
        "\n",
        "print(\"\\nPrimeiras colunas geradas pelo encoding:\")\n",
        "for coluna in nomes_features_ml[:15]:\n",
        "    print(f\" - {coluna}\")\n",
        "\n",
        "if X.shape[0] != len(df_ml):\n",
