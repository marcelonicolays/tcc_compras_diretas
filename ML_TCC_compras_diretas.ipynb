        "## Modelos de Aprendizado"
      ],
      "metadata": {
        "id": "K8hHBV5etIf5"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Isolation Forest"
      ],
      "metadata": {
        "id": "BCxAjElYrTLs"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# TREINAMENTO DO MODELO\n",
        "\n",
        "print(\"Treinando o Isolation Forest...\")\n",
        "\n",
        "modelo_iforest = IsolationForest(\n",
        "    n_estimators=300,\n",
        "    contamination=0.05, # 5% conforme sua escolha\n",
        "    random_state=42,\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "modelo_iforest.fit(X)\n",
        "\n",
        "# CLASSIFICAÇÃO DOS REGISTROS\n",
        "# 1 = normal\n",
        "# -1 = anomalia identificada pelo modelo\n",
        "df_ml['iforest_pred'] = modelo_iforest.predict(X)\n",
        "\n",
        "# Score original: valores menores indicam maior anomalia\n",
        "df_ml['score_iforest'] = modelo_iforest.score_samples(X)\n",
        "\n",
        "# Score invertido: valores maiores indicam maior anomalia\n",
        "df_ml['score_anomalia_iforest'] = -df_ml['score_iforest']\n",
        "\n",
        "df_ml['anomalia_iforest'] = (\n",
        "    df_ml['iforest_pred'] == -1\n",
        ")\n",
        "\n",
        "\n",
        "# RESUMO GERAL DOS RESULTADOS\n",
        "total = len(df_ml)\n",
        "total_anomalias = int(df_ml['anomalia_iforest'].sum())\n",
        "total_normais = total - total_anomalias\n",
        "\n",
        "print(\"\\nRESULTADOS GERAIS DO ISOLATION FOREST\")\n",
        "print(\"-\" * 50)\n",
        "print(f\"Total de registros (itens): {total:,}\")\n",
        "print(f\"Registros normais: {total_normais:,}\")\n",
        "print(f\"Anomalias identificadas: {total_anomalias:,}\")\n",
        "print(f\"Percentual de itens anômalos: {total_anomalias / total:.2%}\")\n",
        "\n",
        "\n",
        "# ANÁLISE POR PROCESSO\n",
        "print(\"\\nANÁLISE POR PROCESSO\")\n",
        "print(\"-\" * 50)\n",
        "\n",
        "# Total de processos únicos na base\n",
        "total_processos = df_ml['idprocesso'].nunique()\n",
        "\n",
        "# Processos que possuem pelo menos 1 item anômalo\n",
        "processos_impactados = df_ml.loc[df_ml['anomalia_iforest'], 'idprocesso'].nunique()\n",
        "\n",
        "print(f\"Total de processos únicos: {total_processos:,}\")\n",
        "print(f\"Processos com pelo menos 1 item anômalo: {processos_impactados:,}\")\n",
        "print(f\"Percentual de processos impactados: {processos_impactados / total_processos:.2%}\")\n",
        "\n",
        "# Agregação por processo: total de itens e total de anomalias\n",
        "resumo_processos = (\n",
        "    df_ml.groupby('idprocesso')\n",
        "    .agg(\n",
        "        total_itens=('anomalia_iforest', 'size'),\n",
        "        itens_anomalia=('anomalia_iforest', 'sum')\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "# Conta processos com 100% de itens anômalos\n",
        "qtd_processos_100 = len(\n",
        "    resumo_processos[\n",
        "        resumo_processos['itens_anomalia'] == resumo_processos['total_itens']\n",
        "    ]\n",
        ")\n",
        "\n",
        "print(f\"\\nProcessos com 100% de itens anômalos: {qtd_processos_100:,}\")\n",
        "# Calcula o percentual de itens anômalos por processo\n",
        "resumo_processos['percentual_anomalia'] = (\n",
        "    resumo_processos['itens_anomalia'] / resumo_processos['total_itens']\n",
        ") * 100\n",
        "\n",
        "# Estatísticas descritivas do percentual de anomalia (apenas processos com anomalia)\n",
        "processos_com_anomalia = resumo_processos[resumo_processos['itens_anomalia'] > 0]\n",
        "\n",
        "print(\"\\nDistribuição do percentual de anomalia (processos com ao menos 1 item anômalo):\")\n",
        "print(f\"  Média: {processos_com_anomalia['percentual_anomalia'].mean():.2f}%\")\n",
        "print(f\"  Mediana: {processos_com_anomalia['percentual_anomalia'].median():.2f}%\")\n",
        "print(f\"  Máximo: {processos_com_anomalia['percentual_anomalia'].max():.2f}%\")\n",
        "print(f\"  Mínimo: {processos_com_anomalia['percentual_anomalia'].min():.2f}%\")\n",
        "\n",
        "# Top 10 processos com maior percentual de anomalia\n",
        "print(\"\\nTOP 10 PROCESSOS COM MAIOR PERCENTUAL DE ITENS ANÔMALOS\")\n",
        "print(\"-\" * 50)\n",
        "top_processos = (\n",
        "    processos_com_anomalia\n",
        "    .sort_values('percentual_anomalia', ascending=False)\n",
        "    .head(10)\n",
        "    .round(2)\n",
        ")\n",
        "display(top_processos)\n",
        "\n",
        "\n",
        "# TOP 15 ITENS COM MAIOR SCORE DE ANOMALIA\n",
        "print(\"\\n15 ITENS COM MAIOR SCORE DE ANOMALIA\")\n",
        "print(\"-\" * 50)\n",
        "\n",
        "colunas_exibicao = [\n",
        "    coluna for coluna in [\n",
        "        'numero_processo',\n",
        "        'ano_processo',\n",
        "        'unidade',\n",
        "        'fornecedor',\n",
        "        'item',\n",
        "        'quantidade',\n",
        "        'valor_unitario',\n",
        "        'valor_processo',\n",
        "        'afastamento',\n",
        "        'score_anomalia_iforest'\n",
        "    ]\n",
        "    if coluna in df_ml.columns\n",
        "]\n",
        "\n",
        "display(\n",
        "    df_ml.loc[df_ml['anomalia_iforest'], colunas_exibicao]\n",
        "    .sort_values('score_anomalia_iforest', ascending=False)\n",
        "    .head(15)\n",
        "    .round(4)\n",
        ")\n",
        "\n",
        "print(\"\\nModelo treinado. Os resultados estão em df_ml.\")\n"
      ],
