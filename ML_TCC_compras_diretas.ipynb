      "cell_type": "markdown",
      "source": [
        "* K-Means com K=22"
      ],
      "metadata": {
        "id": "bZkvadn0JzDB"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Conferir se a matriz X corresponde aos registros do dataframe\n",
        "if X.shape[0] != len(df_ml):\n",
        "    raise ValueError(\n",
        "        \"A quantidade de registros de X é diferente da quantidade de linhas de df_ml.\"\n",
        "    )\n",
        "\n",
        "# Configurar e executar o K-Means\n",
        "modelo_kmeans = KMeans(\n",
        "    n_clusters=22,\n",
        "    random_state=42,\n",
        "    n_init=10,\n",
        "    max_iter=300,\n",
        "    algorithm='lloyd'\n",
        ")\n",
        "\n",
        "df_ml['cluster_kmeans'] = modelo_kmeans.fit_predict(X)\n",
        "\n",
        "# Calcular a distância de cada registro ao centroide do próprio cluster\n",
        "distancias_centroides = modelo_kmeans.transform(X)\n",
        "\n",
        "df_ml['distancia_centroide_kmeans'] = distancias_centroides[\n",
        "    np.arange(len(df_ml)),\n",
        "    df_ml['cluster_kmeans'].to_numpy()\n",
        "]\n",
        "\n",
        "print('K-MEANS EXECUTADO COM SUCESSO')\n",
        "print('-' * 45)\n",
        "print(f'Total de registros: {len(df_ml):,}')\n",
        "print(f'Quantidade de clusters: {modelo_kmeans.n_clusters}')\n",
        "print(f'Inércia final: {modelo_kmeans.inertia_:.2f}')\n",
        "\n",
        "# Quantidade de registros em cada cluster\n",
        "print('\\nQUANTIDADE DE REGISTROS POR CLUSTER')\n",
        "\n",
        "contagem_clusters = (\n",
        "    df_ml['cluster_kmeans']\n",
        "    .value_counts()\n",
        "    .sort_index()\n",
        "    .rename_axis('Cluster')\n",
        "    .reset_index(name='Quantidade')\n",
        ")\n",
        "\n",
        "contagem_clusters['Percentual'] = (\n",
        "    100 * contagem_clusters['Quantidade'] / len(df_ml)\n",
        ").round(2)\n",
        "\n",
        "display(contagem_clusters)\n",
        "\n",
        "# Perfil inicial dos clusters\n",
        "print('\\nPERFIL INICIAL DOS CLUSTERS')\n",
        "\n",
        "resumo_clusters = (\n",
        "    df_ml.groupby('cluster_kmeans')\n",
        "    .agg(\n",
        "        total_itens=('cluster_kmeans', 'size'),\n",
        "        mediana_valor_processo=('valor_processo', 'median'),\n",
        "        mediana_valor_unitario=('valor_unitario', 'median'),\n",
        "        mediana_quantidade=('quantidade', 'median'),\n",
        "        fornecedores_distintos=('fornecedor', 'nunique'),\n",
        "        unidades_contratantes=('unidade', 'nunique'),\n",
        "        percentual_zscore_sinalizado=(\n",
        "            'anomalia_zscore',\n",
        "            lambda s: (\n",
        "                100 * s.eq(True).sum() / s.notna().sum()\n",
        "                if s.notna().any() else np.nan\n",
        "            )\n",
        "        )\n",
        "    )\n",
        "    .round(2)\n",
        "    .reset_index()\n",
        "    .rename(columns={'cluster_kmeans': 'Cluster'})\n",
        ")\n",
        "\n",
        "display(resumo_clusters)\n",
        "\n",
        "# Dez registros mais distantes dos respectivos centroides\n",
        "print('\\n10 REGISTROS MAIS DISTANTES DOS CENTROIDES')\n",
        "\n",
        "colunas_exibicao = [\n",
        "    'idprocesso',\n",
        "    'fornecedor',\n",
        "    'unidade',\n",
        "    'item',\n",
        "    'valor_processo',\n",
        "    'valor_unitario',\n",
        "    'zscore_preco',\n",
        "    'anomalia_zscore',\n",
        "    'cluster_kmeans',\n",
        "    'distancia_centroide_kmeans'\n",
        "]\n",
        "\n",
        "display(\n",
        "    df_ml.nlargest(10, 'distancia_centroide_kmeans')[\n",
        "        colunas_exibicao\n",
        "    ].reset_index(drop=True)\n",
        ")\n"
      ],
