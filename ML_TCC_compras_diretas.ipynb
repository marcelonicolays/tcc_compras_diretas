    {
      "cell_type": "markdown",
      "source": [
        "##  Análise de Z-Score"
      ],
      "metadata": {
        "id": "DvdUoqfHLbFV"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Z-score dos preços unitários por item e unidade de medida\n",
        "\n",
        "colunas_grupo = ['item', 'unidade_medida']\n",
        "\n",
        "grupo_preco = df_ml.groupby(\n",
        "    colunas_grupo,\n",
        "    dropna=False\n",
        ")['valor_unitario']\n",
        "\n",
        "# Estatísticas de cada grupo\n",
        "n_observacoes = grupo_preco.transform('count')\n",
        "media_preco = grupo_preco.transform('mean')\n",
        "desvio_preco = grupo_preco.transform(\n",
        "    lambda s: s.std(ddof=0)\n",
        ")\n",
        "\n",
        "# Calcular apenas para grupos com pelo menos 1 observação\n",
        "# e desvio padrão maior que zero\n",
        "condicao_valida = (\n",
        "    (n_observacoes >= 1) &\n",
        "    (desvio_preco > 0)\n",
        ")\n",
        "\n",
        "# Z-score: distância em desvios-padrão em relação à média\n",
        "df_ml['zscore_preco'] = (\n",
        "    (df_ml['valor_unitario'] - media_preco)\n",
        "    / desvio_preco\n",
        ").where(condicao_valida)\n",
        "\n",
        "# Sinalizar preços pelo menos 2 desvios-padrão acima da média\n",
        "df_ml['anomalia_zscore'] = (\n",
        "    df_ml['zscore_preco']\n",
        "    .ge(2)\n",
        "    .where(df_ml['zscore_preco'].notna(), pd.NA)\n",
        "    .astype('boolean')\n",
        ")\n",
        "\n",
        "# Resumo dos resultados\n",
        "total_itens = len(df_ml)\n",
        "itens_avaliaveis = df_ml['zscore_preco'].notna().sum()\n",
        "total_anomalias = df_ml['anomalia_zscore'].sum()\n",
        "\n",
        "print('ANÁLISE DE Z-SCORE DOS PREÇOS UNITÁRIOS')\n",
        "print('-' * 45)\n",
        "print(f'Total de registros: {total_itens:,}')\n",
        "print(f'Registros avaliáveis: {itens_avaliaveis:,}')\n",
        "print(f\"Registros não avaliáveis (NA): {df_ml['anomalia_zscore'].isna().sum():,}\")\n",
        "print(f'Preços com Z-score >= 2: {total_anomalias:,}')\n",
        "\n",
        "if itens_avaliaveis > 0:\n",
        "    percentual = 100 * total_anomalias / itens_avaliaveis\n",
        "    print(f'Percentual entre os avaliáveis: {percentual:.2f}%')\n",
        "\n",
        "# Exibir os 10 maiores Z-scores\n",
        "colunas_exibicao = [\n",
        "    'item',\n",
        "    'unidade_medida',\n",
        "    'fornecedor',\n",
        "    'unidade',\n",
        "    'valor_unitario',\n",
        "    'zscore_preco',\n",
        "    'anomalia_zscore'\n",
        "]\n",
        "\n",
        "display(\n",
        "    df_ml.nlargest(10, 'zscore_preco')[\n",
        "        colunas_exibicao\n",
        "    ].reset_index(drop=True)\n",
        ")\n"
      ],
